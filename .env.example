# Local development only — never commit real keys.
# Respan Gateway (loopback) — the app's AI proxy (vite.config.ts) sends every
# request here, and the gateway routes it to the provider below.
# Start it with `npm run gateway` (see gateway.toml).
AI_API_BASE=http://127.0.0.1:8087/v1
# Direct provider, bypassing the gateway:
# AI_API_BASE=https://api.z.ai/api/paas/v4
# Z.ai (OpenAI-compatible) — the gateway reads this key as its provider key.
AI_API_KEY=
AI_MODEL=glm-4.7-flash

# Nace Drex (decision API) — typed questions over a case state, answered with
# calibrated probabilities per option. Read server-side in vite.config.ts and
# reached by the app through /api/nace/decide; never exposed to the browser.
NACE_API_KEY=
# Drex model requested by default (drex-latest follows the current version).
# NACE_DREX_MODEL=drex-latest

# Supabase (optional, for online challenge mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
