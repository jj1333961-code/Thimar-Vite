<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشة وقت الصلاة: إطار كامل الشاشة يستضيف بطاقة الأذان التي تُبنى برمجيًا
  (اسم الصلاة، الوقت، التاريخ، الزخرفة) — بلا أي صورة أعلى الصفحة.
  لكل صلاة لونها وزخرفتها وعبارتها من AdhanWindowView.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/adhan_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/adhan_ink"
  android:keepScreenOn="true"
  android:layoutDirection="rtl">

  <ScrollView
    android:id="@+id/adhan_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
      android:id="@+id/adhan_host"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical" />
  </ScrollView>
</FrameLayout>
