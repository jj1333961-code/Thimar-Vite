<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/adhan_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/black"
  android:keepScreenOn="true">

  <ImageView
    android:id="@+id/adhan_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="centerCrop" />

  <View
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/adhan_scrim" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="28dp"
    android:paddingRight="28dp">

    <ImageView
      android:id="@+id/adhan_logo"
      android:layout_width="96dp"
      android:layout_height="96dp"
      android:contentDescription="@string/app_name"
      android:src="@mipmap/ic_launcher" />

    <TextView
      android:id="@+id/adhan_app_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:fontFamily="sans-serif-medium"
      android:letterSpacing="0.08"
      android:text="@string/app_name"
      android:textColor="#FFFFFF"
      android:textSize="20sp" />

    <TextView
      android:id="@+id/adhan_prayer"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="28dp"
      android:fontFamily="sans-serif-medium"
      android:gravity="center"
      android:textColor="#FFFFFF"
      android:textSize="34sp" />

    <TextView
      android:id="@+id/adhan_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:fontFamily="sans-serif"
      android:textColor="#F4E6C3"
      android:textDirection="ltr"
      android:textSize="44sp" />

    <TextView
      android:id="@+id/adhan_date"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="14dp"
      android:gravity="center"
      android:textColor="#E8E2D4"
      android:textSize="16sp" />

    <TextView
      android:id="@+id/adhan_hijri"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center"
      android:textColor="#CFC7B6"
      android:textSize="14sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/adhan_hint"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="36dp"
    android:text="@string/adhan_dismiss_hint"
    android:textColor="#B3FFFFFF"
    android:textSize="13sp" />
</FrameLayout>
